# Copie para .env somente no ambiente local e preencha os campos obrigatorios.
# Nunca armazene credenciais reais neste arquivo ou no Git.
DATABASE_URL=sqlite:///./helphealth.db
SECRET_KEY=
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=

# Deixe SMTP vazio para testes locais sem envio de email.
SMTP_USERNAME=
SMTP_PASSWORD=

# Redis e mensageria sao opcionais; mantenha WhatsApp desativado sem servico configurado.
REDIS_URL=
WHATSAPP_ENABLED=false
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_WEBHOOK_SECRET=
WHATSAPP_FRONTEND_BASE_URL=http://localhost:5173
TRUSTED_PROXY_HOPS=0
