# Copie este arquivo para .env apenas no ambiente local.
# Nunca suba o .env real para o GitHub ou para um zip publico.

# Obrigatorias: banco e segredo da sessao.
# Local:
DATABASE_URL=sqlite:///./helpweb_health_local.db
# Hospedagem opcional: configure a URL real no ambiente do seu provedor.
# DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco?sslmode=require
SECRET_KEY=gere_uma_chave_aleatoria_com_32_caracteres_ou_mais

# Conta administrativa criada na inicializacao. Troque por valores reais.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=troque_esta_senha_antes_de_publicar

# Frontend autorizado a acessar a API. Separe multiplas origens por virgula.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cookies: local HTTP usa false/lax; producao HTTPS exige true.
# Use none apenas para frontend/API em sites diferentes (junto com true).
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# Deixe vazio ou remova no local. Nao use dominio do frontend aqui.
AUTH_COOKIE_DOMAIN=

# Opcional no local. Para envio real, configure Gmail com senha de app.
# As demais regras SMTP sao fixas no codigo. Nao use credenciais de exemplo.
SMTP_USERNAME=
SMTP_PASSWORD=

# Opcional. Sem esta URL, rate limit distribuido e fila WhatsApp usam o modo
# local e a integracao WhatsApp permanece indisponivel.
REDIS_URL=

# Integracao opcional. Mantenha false ate possuir Redis e Evolution configurados.
WHATSAPP_ENABLED=false
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_WEBHOOK_SECRET=
WHATSAPP_FRONTEND_BASE_URL=http://localhost:5173

# 0 ignora headers de proxy enviados pelo cliente. Use 1 somente depois de
# confirmar que a hospedagem/proxy sobrescreve o IP real com confianca.
TRUSTED_PROXY_HOPS=0

# Politicas de seguranca, expiracoes, limites, SMTP, logs, migracoes e worker
# ficam versionadas em app/core/security_policy.py. Nao sao configuradas por
# variaveis de ambiente para evitar divergencia e alteracoes acidentais.
